{
	"name": "haven",
	"scripts": {
		"dev": "turbo dev",
		"dev:backoffice": "pnpm --filter backoffice dev",
		"dev:prod": "pnpm --filter haven-app dev:prod",
		"build": "turbo build",
		"deploy": "pnpm --filter api run deploy",
		"deploy:api": "pnpm --filter api run deploy",
		"db:generate": "pnpm --filter api db:generate",
		"db:migrate": "pnpm --filter api db:migrate",
		"db:studio": "pnpm --filter api db:studio",
		"db:seed": "pnpm --filter api db:seed",
		"db:seed-staff": "pnpm --filter api db:seed-staff",
		"db:visualizer": "pnpm --filter api db:visualizer",
		"types": "turbo types",
		"lint": "pnpm dlx @biomejs/biome lint --write",
		"format": "pnpm dlx @biomejs/biome format --write",
		"check": "pnpm dlx @biomejs/biome check --write"
	},
	"private": true,
	"packageManager": "pnpm@9.0.0",
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@neondatabase/serverless": "^1.1.0",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"turbo": "^2.10.0"
	}
}
