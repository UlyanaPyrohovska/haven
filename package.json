{
	"name": "haven",
	"scripts": {
		"dev": "turbo dev",
		"dev:backoffice": "pnpm --filter backoffice dev",
		"dev:prod": "pnpm --filter haven-app dev:prod",
		"build": "turbo build",
		"typecheck": "turbo typecheck",
		"test": "turbo test",
		"deploy:api": "pnpm --filter api run deploy",
		"deploy:backoffice": "pnpm --filter backoffice run deploy",
		"release:ios": "pnpm --filter haven-app release:ios",
		"db:generate": "pnpm --filter api db:generate",
		"db:migrate": "pnpm --filter api db:migrate",
		"db:studio": "pnpm --filter api db:studio",
		"db:seed": "pnpm --filter api db:seed",
		"db:seed-demo": "pnpm --filter api db:seed-demo",
		"db:visualizer": "pnpm --filter api db:visualizer",
		"lint": "biome lint --write",
		"format": "biome format --write",
		"check": "biome check --write"
	},
	"private": true,
	"packageManager": "pnpm@12.11.2",
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"turbo": "^2.10.0"
	}
}
