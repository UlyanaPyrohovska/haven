# Optional: override API proxy target (default http://localhost:8787)
# VITE_API_PROXY_TARGET=http://localhost:8787

# API origin for production builds (empty in dev: requests go through the Vite proxy)
# VITE_API_URL=https://haven.pirogotter.dev

# Better Auth client base URL (defaults to http://localhost:5173/auth in dev via Vite proxy)
# VITE_AUTH_BASE_URL=http://localhost:5173/auth
