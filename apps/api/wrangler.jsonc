{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "haven-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-28",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	// Simulation tick (agents act, real users get due drops). Gated by SIMULATION_ENABLED="true".
	"triggers": {
		"crons": ["*/30 * * * *"]
	},
	"vars": {
		"SIMULATION_ENABLED": "false"
	}
}
