{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "haven-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-28",
	"compatibility_flags": ["nodejs_compat"],
	// Custom domain; the workers.dev URL stays live so older app builds keep working.
	"routes": [{ "pattern": "haven.pirogotter.dev", "custom_domain": true }],
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	// Simulation tick at 08:00 and 20:00 UTC (agents act, real users get due drops), and a location-walker
	// step every 10 min (staff test tool; see src/index.ts WALKER_CRON). Both gated by SIMULATION_ENABLED.
	"triggers": {
		"crons": ["0 8,20 * * *", "*/10 * * * *"]
	},
	// Chat sockets: one ChatRoom per conversation, always created in the EU jurisdiction.
	"durable_objects": {
		"bindings": [{ "name": "CHAT", "class_name": "ChatRoom" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],
	// Verification emails via Cloudflare Email Sending. The sender domain must be onboarded:
	// `npx wrangler email sending enable <domain>`. remote: true makes `wrangler dev` send real mail.
	"send_email": [{ "name": "EMAIL", "remote": true }],
	// Bio embeddings (@cf/baai/bge-small-en-v1.5). Workers AI is a DPO-approved subprocessor for bios (T9).
	"ai": { "binding": "AI" },
	"vars": {
		"SIMULATION_ENABLED": "true",
		// Must be an address on the onboarded domain.
		"EMAIL_FROM": "no-reply@pirogotter.dev"
	}
}
