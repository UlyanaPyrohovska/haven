{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "haven-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-28",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	// Simulation tick (agents act, real users get due drops). Gated by SIMULATION_ENABLED="true".
	"triggers": {
		"crons": ["*/30 * * * *"]
	},
	// Chat sockets: one ChatRoom per conversation, always created in the EU jurisdiction.
	"durable_objects": {
		"bindings": [{ "name": "CHAT", "class_name": "ChatRoom" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],
	"vars": {
		"SIMULATION_ENABLED": "false"
	}
}
