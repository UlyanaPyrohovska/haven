# Used by Drizzle CLI and seed scripts (`pnpm db:migrate`, `pnpm db:seed`).
# Wrangler local dev reads `.env.dev` via `--env-file` (see `.env.dev.example`).
# Production Worker secrets are set via `wrangler secret put` — not these files.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATASET_DIR=/path/to/Dataset
BETTER_AUTH_SECRET=your-local-dev-secret
BETTER_AUTH_URL=https://haven.pirogotter.dev
STAFF_ADMIN_EMAIL=staff@haven.local
STAFF_ADMIN_PASSWORD=haven-staff-change-me
STAFF_ADMIN_NAME=Haven Staff
# Push notifications (optional; push is skipped when unset). Set on the Worker with `wrangler secret put`.
# FCM_PROJECT_ID=  FCM_CLIENT_EMAIL=  FCM_PRIVATE_KEY=   (Firebase service account JSON fields)
# APNS_KEY_ID=  APNS_TEAM_ID=  APNS_PRIVATE_KEY=          (Apple .p8 auth key)
# APNS_BUNDLE_ID=com.ulianapyrohovska.haven  APNS_SANDBOX=true   (sandbox for development builds)
