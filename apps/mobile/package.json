{
	"name": "haven-app",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"scripts": {
		"dev": "node scripts/ensure-android-tunnel.mjs && dotenv -c dev -- expo start --dev-client",
		"dev:prod": "node scripts/ensure-android-tunnel.mjs && dotenv -c production -- expo start --dev-client",
		"android": "node scripts/ensure-android-tunnel.mjs && dotenv -c dev -- expo run:android",
		"ios": "dotenv -c dev -- expo run:ios",
		"prebuild": "expo prebuild --clean",
		"web": "expo start --web",
		"lint": "expo lint",
		"android:tunnel": "adb reverse tcp:8787 tcp:8787",
		"build:dev:ios": "eas build --profile development --platform ios",
		"build:dev:android": "eas build --profile development --platform android",
		"build:preview:ios": "eas build --profile preview --platform ios",
		"build:preview:android": "eas build --profile preview --platform android",
		"build:prod:ios": "eas build --profile production --platform ios",
		"build:local:ios": "EXPO_NO_CAPABILITY_SYNC=1 EXPO_ASC_API_KEY_PATH=./certs/AuthKey_KD575C2VC3.p8 EXPO_ASC_KEY_ID=KD575C2VC3 EXPO_ASC_ISSUER_ID=c2a4b025-8734-4592-a0e3-78799851af45 eas build --profile production --platform ios --local --output build/haven.ipa",
		"build:local:android": "eas build --profile preview --platform android --local --output build/haven.apk",
		"submit:ios": "eas submit --profile production --platform ios --path build/haven.ipa",
		"release:ios": "pnpm build:local:ios && pnpm submit:ios"
	},
	"dependencies": {
		"@better-auth/expo": "^1.6.23",
		"@expo-google-fonts/kodchasan": "^0.4.1",
		"@expo/metro-runtime": "~57.0.15",
		"@expo/vector-icons": "^15.1.1",
		"@react-navigation/bottom-tabs": "^7.4.0",
		"@react-navigation/elements": "^2.6.3",
		"@react-navigation/native": "^7.1.8",
		"@tanstack/react-query": "^5.101.2",
		"better-auth": "^1.6.23",
		"expo": "~57.0.20",
		"expo-constants": "~57.0.17",
		"expo-dev-client": "~57.0.19",
		"expo-font": "~57.0.3",
		"expo-haptics": "~57.0.2",
		"expo-image": "~57.0.4",
		"expo-image-manipulator": "~57.0.16",
		"expo-image-picker": "~57.0.16",
		"expo-linking": "~57.0.9",
		"expo-localization": "~57.0.1",
		"expo-location": "~57.0.20",
		"expo-network": "~57.0.1",
		"expo-notifications": "~57.0.24",
		"expo-router": "~57.0.19",
		"expo-secure-store": "~57.0.3",
		"expo-splash-screen": "~57.0.8",
		"expo-status-bar": "~57.0.1",
		"expo-symbols": "~57.0.2",
		"expo-system-ui": "~57.0.3",
		"expo-web-browser": "~57.0.2",
		"i18next": "^26.4.2",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-i18next": "^17.0.13",
		"react-native": "0.86.3",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-keyboard-controller": "1.21.9",
		"react-native-reanimated": "~4.5.1",
