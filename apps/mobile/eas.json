			"developmentClient": true,
			"distribution": "store",
			"env": {
				"EXPO_PUBLIC_API_URL": "https://haven.pirogotter.dev"
			}
		},
		"preview": {
			"distribution": "internal",
			"env": {
				"EXPO_PUBLIC_API_URL": "https://haven.pirogotter.dev"
			}
		},
		"production": {
			"autoIncrement": true,
