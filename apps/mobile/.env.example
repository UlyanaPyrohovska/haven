# Base URL of the Haven API (Better Auth is mounted at /auth).
# Leave unset to use the default, http://localhost:8787.
#
# iOS simulator:     the default works as-is.
# Android emulator:  the default works once port 8787 is tunnelled over adb (same idea
#                    as Expo's Metro tunnel on 8081). `pnpm dev` sets this up
#                    automatically when an emulator is connected; if you hot-reload
#                    after restarting the emulator, run `pnpm android:tunnel` once.
# Physical device:   `pnpm dev` starts the API on all interfaces; point this at your
#                    machine's LAN address (same IP Metro shows), e.g.
#                    EXPO_PUBLIC_API_URL=http://192.168.1.20:8787
#
# This value is inlined at bundle time, so restart Expo after changing it.
EXPO_PUBLIC_API_URL=http://localhost:8787
